{
  "schemaVersion": 1,
  "id": "rbip",
  "version": "${version}",
  "name": "Recipe Book Is Pain",
  "description": "Makes the recipe book use a little more enums",
  "authors": [
    "zenfyr"
  ],
  "contact": {
    "sources": "https://github.com/constellation-mc/rbip",
    "issues": "https://github.com/constellation-mc/rbip/issues"
  },
  "license": "MIT",
  "icon": "assets/rbip/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.zenfyr.rbip.RecipeBookIsPain"
    ]
  },
  "mixins": [
    "rbip.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_version}",
    "fabric-api": ">=${fabric_version}"
  }
}
